void main() {
    mapping m = ([ "x" : 10, "y" : 20 ]);

    print(to_string(m["x"]));
    print(to_string(m["y"]));

    m["z"] = 30;
    print(to_string(m["z"]));

    m["x"] = 99;
    print(to_string(m["x"]));

    print(to_string(m["missing"]));

    mapping m2 = ([ 1 : 100, 2 : 200 ]);
    print(to_string(m2[1]));
    m2[3] = 300;
    print(to_string(m2[3]));
	print(m);
}
