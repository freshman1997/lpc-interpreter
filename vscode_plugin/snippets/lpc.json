{
  "main function": {
    "prefix": "main",
    "body": [
      "void main()",
      "{",
      "    $0",
      "}"
    ],
    "description": "Create main function"
  },
  "create hook": {
    "prefix": "create",
    "body": [
      "void create()",
      "{",
      "    $0",
      "}"
    ],
    "description": "Create object initialization hook"
  },
  "typed function": {
    "prefix": "fun",
    "body": [
      "${1:void} ${2:name}(${3:params}) {",
      "    $0",
      "}"
    ],
    "description": "Create typed function"
  },
  "if statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Create if statement"
  },
  "if-else statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create if-else statement"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = ${2:0}; ${3:i} < ${4:n}; ${5:i++}) {",
      "    $0",
      "}"
    ],
    "description": "Create for loop"
  },
  "foreach loop": {
    "prefix": "foreach",
    "body": [
      "foreach (${1:item} in ${2:items}) {",
      "    $0",
      "}"
    ],
    "description": "Create foreach loop"
  },
  "while loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Create while loop"
  },
  "do-while loop": {
    "prefix": "dowhile",
    "body": [
      "do {",
      "    $0",
      "} while (${1:condition});"
    ],
    "description": "Create do-while loop"
  },
  "switch statement": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "    case ${2:0}:",
      "        $0",
      "        break;",
      "}"
    ],
    "description": "Create switch statement"
  },
  "catch block": {
    "prefix": "catch",
    "body": [
      "catch {",
      "    $0",
      "}"
    ],
    "description": "Create catch block"
  },
  "class declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    ${2:int} ${3:field};",
      "}",
      "$0"
    ],
    "description": "Create LPC class declaration"
  },
  "class with inheritance": {
    "prefix": "classi",
    "body": [
      "class ${1:Name} : ${2:Base} {",
      "    ${3:int} ${4:field};",
      "}",
      "$0"
    ],
    "description": "Create class with inheritance"
  },
  "inherit statement": {
    "prefix": "inherit",
    "body": [
      "inherit ${1:path};$0"
    ],
    "description": "Create inherit statement"
  },
  "new instance": {
    "prefix": "new",
    "body": [
      "new ${1:ClassName}($0)"
    ],
    "description": "Create new class instance"
  },
  "array literal": {
    "prefix": "arr",
    "body": [
      "({ ${1:1, 2, 3} })$0"
    ],
    "description": "Create array literal"
  },
  "mapping literal": {
    "prefix": "map",
    "body": [
      "([ ${1:\"key\"} : ${2:value} ])$0"
    ],
    "description": "Create mapping literal"
  },
  "lambda/closure": {
    "prefix": "lambda",
    "body": [
      "fun(${1:params}) {",
      "    $0",
      "}"
    ],
    "description": "Create anonymous function (closure)"
  },
  "call_later": {
    "prefix": "call_later",
    "body": [
      "call_later(${1:delay_ms}, ${2:callback}, ${3:args})$0"
    ],
    "description": "Schedule a timer callback"
  },
  "sprintf": {
    "prefix": "sprintf",
    "body": [
      "sprintf(\"${1:%s}\\n\", ${2:value})$0"
    ],
    "description": "Create sprintf call"
  }
}
