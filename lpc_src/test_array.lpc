class Test {
	int a = 10;
	int b = 20;
	string name = "ready";
	mapping data = {"name": "ready", "age" : 18};
}

void main() {
    int *arr = ({10, 20, 30, 40, 50});
    puts(sizeof(arr));
    puts(arr[0]);
    puts(arr[2]);
    puts(arr[4]);
    int sum = 0;
    int i = 0;
    while (i < sizeof(arr)) {
        sum = sum + arr[i];
        i = i + 1;
    }
	
	Test test = new Test;
	puts(test);
    puts(sum);
    puts(arr);
}
