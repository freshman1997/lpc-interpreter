int activate_hero(int hero_id)
{
	print("Activating hero with ID: ", hero_id);
	if (hero_id <= 0) {
		print("Invalid hero ID: ", hero_id);
		return -1; // Invalid hero ID
	}

	print("Hero with ID %d activated successfully.\n", hero_id);

	return 0;
}