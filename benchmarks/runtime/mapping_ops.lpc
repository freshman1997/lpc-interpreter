int main() {
    int n = 100000;
    int i = 0;
    int sum = 0;
    while (i < n) {
        mapping m = ([ i : i + 1, i + 100 : i + 2, i + 200 : i + 3 ]);
        m[i + 300] = i + 4;
        sum = sum + m[i];
        sum = sum + sizeof(m);
        i = i + 1;
    }
    if (sum <= 0) return 1;
    return sum;
}
