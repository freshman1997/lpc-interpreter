int main() {
    int n = 2000000;
    int i = 0;
    int sum = 0;
    while (i < n) {
        int a = i & 0xFF;
        int b = a | 0x10;
        int c = b ^ 0x55;
        int d = c << 2;
        int e = d >> 1;
        sum = sum + e;
        i = i + 1;
    }
    if (sum <= 0) return 1;
    return sum;
}
