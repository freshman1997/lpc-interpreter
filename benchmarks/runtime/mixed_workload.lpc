int main() {
    int n = 200000;
    int i = 0;
    int score = 0;
    string mode = "a";
    while (i < n) {
        mapping m = ([ i : i + 1, i + 10 : i + 2 ]);
        int v = m[i];
        score = score + v;
        if ((i & 7) == 0 && mode == "a") {
            score = score + 1;
        }
        i = i + 1;
    }
    if (score <= 0) return 1;
    return score;
}
