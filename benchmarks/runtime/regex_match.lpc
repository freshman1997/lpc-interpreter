int main() {
    int n = 50000;
    int i = 0;
    int sum = 0;
    while (i < n) {
        int ok = regexp("hello-123", "[a-z]+-[0-9]+");
        sum = sum + ok;
        string s = regex_replace("abc-123-xyz", "[0-9]+", "N");
        sum = sum + strlen(s);
        i = i + 1;
    }
    if (sum <= 0) return 1;
    return sum;
}
