int main() {
    int n = 100000;
    int i = 0;
    int sum = 0;
    string base = "the quick brown fox jumps over the lazy dog";
    while (i < n) {
        int pos = strsrch(base, "fox");
        sum = sum + pos;
        string s = replace_string(base, "fox", "cat");
        sum = sum + strlen(s);
        i = i + 1;
    }
    if (sum <= 0) return 1;
    return sum;
}
