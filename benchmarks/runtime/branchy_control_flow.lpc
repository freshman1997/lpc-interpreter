int main() {
    int n = 1500000;
    int i = 0;
    int sum = 0;
    while (i < n) {
        switch (i & 3) {
        case 0:
            sum = sum + 3;
            break;
        case 1:
            sum = sum + 7;
            break;
        case 2:
            sum = sum + 11;
            break;
        default:
            sum = sum + 13;
            break;
        }
        if ((i & 15) == 0) {
            sum = sum - 1;
        } else if ((i & 7) == 0) {
            sum = sum + 2;
        }
        i = i + 1;
    }
    if (sum <= 0) return 1;
    return sum;
}
